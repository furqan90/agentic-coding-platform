{
  "$schema": "https://opencode.ai/config.json",
  "model": "proxy/qwen3-coder:30b-32k",
  "provider": {
    "proxy": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "LiteLLM proxy (DGX Spark)",
      "options": {
        "baseURL": "https://localhost/v1",
        "apiKey": "${OPENCODE_PROXY_API_KEY}"
      },
      "models": {
        "qwen3-coder:30b-32k": {
          "name": "Qwen3-Coder 30B Q4_K_M (32K context, via LiteLLM)",
          "limit": { "context": 32768, "output": 4096 }
        }
      }
    }
  }
}
