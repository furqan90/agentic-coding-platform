# Copy to .env and fill in real values before starting the stack.

# Master key for LiteLLM — used to issue per-user virtual keys via the admin API.
# Generate with: openssl rand -hex 32
LITELLM_MASTER_KEY=sk-change-this-secret

# Password for the LiteLLM Postgres database (any strong password).
# Default is "litellm" if omitted — change this for any shared environment.
LITELLM_DB_PASSWORD=litellm

# OTLP endpoint for the existing observability stack.
# Default uses host.docker.internal (Docker Desktop on Windows/Mac).
# For a separate host, set to http://<host>:4317
OTEL_EXPORTER_OTLP_ENDPOINT=http://host.docker.internal:4317
